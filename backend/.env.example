# Local development sample ONLY — copy manually to backend/.env.
# python-dotenv reads backend/.env; it never reads this example automatically.
# The actual .env stays untracked. Do NOT commit secrets or use this in production.
# Existing operating-system environment variables override values in .env.

# REQUIRED: generate a unique key locally (see backend/README.md).
# Leave blank here to avoid shipping a working secret key.
DJANGO_SECRET_KEY=

# Development defaults. Never enable DEBUG on a public deployment.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# FUTURE DESIGN ONLY — no MCP endpoint or server is implemented.
# Do not put access tokens into this public example file.
# DCH_MCP_ENDPOINT_URL=https://mcp.example.invalid/mcp
# DCH_MCP_AUTH_MODE=oauth

# OPTIONAL: local-only Ollama smoke pilot. No automatic agent dispatch.
# The model is never downloaded automatically; use an installed, small model.
DCH_OLLAMA_ENABLED=0
DCH_OLLAMA_URL=http://127.0.0.1:11434
DCH_OLLAMA_MODEL=
DCH_OLLAMA_TIMEOUT_SECONDS=30
# Set only when Ollama runs on a separate, explicitly approved private LAN IP.
DCH_OLLAMA_ALLOWED_LAN_IP=
